---
interface Props {
  title?: string;
  description?: string;
  campaignScript?: boolean;
}

const {
  title = 'Openfield — Riverbend Learning Garden',
  description = "Help turn Riverbend's unused courtyard into a garden for learning, growing, and gathering.",
  campaignScript = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173b2f" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/checkout-presentations.css" />
    <script is:inline type="module" src="/checkout-presentations.js"></script>
    {campaignScript && <script is:inline src="/campaign.js" defer></script>}
  </head>
  <body>
    <slot />
  </body>
</html>
