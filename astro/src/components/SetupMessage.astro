---
interface Props {
  error?: { code: string; message: string } | undefined;
}

const { error } = Astro.props;
---

{
  error?.code === 'configuration_error' ? (
    <section class="setup-card" role="status">
      <span>Setup required</span>
      <strong>Connect this copy to Inttegro</strong>
      <p>Add the API key, campaign Product and Price IDs, and public URL as server-side environment variables. No secret belongs in this component.</p>
      <div>
        <a href="https://studio.inttegro.com/keys">Create an API key</a>
        <a href="https://github.com/zebodotdev/inttegro-demos/tree/main/astro">Read the guide</a>
      </div>
    </section>
  ) : error ? (
    <p class="inline-error" role="alert">
      <strong>{error.code.replaceAll('_', ' ')}:</strong> {error.message}
    </p>
  ) : null
}
