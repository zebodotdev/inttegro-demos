{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "inttegro/demo-laravel",
  "type": "project",
  "description": "Hosted checkout demo for the Inttegro PHP SDK and Laravel.",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "inttegro/sdk": "5.1.0",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.50"
  },
  "autoload": { "psr-4": { "App\\": "app/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": "@php artisan test"
  },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
