---
import SetupMessage from './SetupMessage.astro';

interface Props {
  attemptId: string;
  error?: { code: string; message: string } | undefined;
}

const { attemptId, error } = Astro.props;
---

<aside class="support-card" id="support" aria-labelledby="support-title">
  <div class="funding">
    <div class="funding-state"><span><span class="live-dot"></span> Community funded</span><span>18 days left</span></div>
    <strong>GHS 182,450</strong>
    <p>raised of GHS 250,000</p>
    <div class="progress" role="progressbar" aria-label="Campaign funding" aria-valuemin="0" aria-valuemax="250000" aria-valuenow="182450"><i></i></div>
    <dl><div><dt>624</dt><dd>supporters</dd></div><div><dt>73%</dt><dd>funded</dd></div><div><dt>3</dt><dd>field notes</dd></div></dl>
  </div>
  <div class="support-impact-promise"><span class="support-impact-mark" aria-hidden="true">✦</span><p><strong>GHS 50 helps stock a growing bed.</strong><span>Seed packs, child-sized tools, and the first planting workshop.</span></p></div>
  <div class="support-form">
    <p class="chapter-number">Make a contribution</p>
    <h2 id="support-title">Choose how you’ll help it grow.</h2>
    <SetupMessage error={error} />
    <form action="/checkout" method="post" data-contribution-form data-checkout-show-line-items="false">
      <input type="hidden" name="attempt_id" value={attemptId} />
      <fieldset>
        <legend class="sr-only">Contribution amount</legend>
        <label class="tier"><input type="radio" name="tier" value="seed" checked /><span><strong>GHS 50</strong><small>Seed the garden</small></span><i>One contribution unit</i></label>
        <label class="tier"><input type="radio" name="tier" value="grower" /><span><strong>GHS 100</strong><small>Help it grow</small></span><i>Two contribution units</i></label>
        <label class="tier"><input type="radio" name="tier" value="steward" /><span><strong>GHS 250</strong><small>Become a steward</small></span><i>Five contribution units</i></label>
      </fieldset>
      <div class="fields">
        <label>Full name<input name="name" value="Akua Mensah" autocomplete="name" required /></label>
        <label>Email address<input type="email" name="email" value="akua@example.com" autocomplete="email" required /></label>
        <label>Phone number<input type="tel" name="phone" value="+233544998605" autocomplete="tel" inputmode="tel" required /></label>
      </div>
      <button type="submit"><span>Contribute GHS 50</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"></path></svg></button>
      <p class="secure-note"><span aria-hidden="true">◇</span> Secure checkout powered by Inttegro</p>
    </form>
  </div>
  <ul class="support-assurances" aria-label="Campaign assurances">
    <li><span aria-hidden="true">✓</span><p><strong>Verified organizer</strong><small>Identity and community role reviewed</small></p></li>
    <li><span aria-hidden="true">↗</span><p><strong>Public allocation</strong><small>Milestones and receipts stay visible</small></p></li>
    <li><span aria-hidden="true">◎</span><p><strong>Flexible funding</strong><small>Contributions go directly to the build</small></p></li>
  </ul>
  <footer><p>Openfield collects immediate contributions for this flexible-funding campaign. Contributions are not represented as tax-deductible gifts.</p></footer>
</aside>
