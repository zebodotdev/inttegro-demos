{
  "schemaVersion": 1,
  "repository": "https://github.com/zebodotdev/inttegro-demos",
  "releaseVersion": "1.4.0",
  "suiteTag": "v1.4.0",
  "domain": {
    "status": "active",
    "provider": "cloudflare",
    "activatedAt": "2026-09-06",
    "catalogHost": "demos.inttegro.dev",
    "demoHostTemplate": "{id}-demo.inttegro.dev",
    "nativeBackendHost": "mobile-api.inttegro.dev"
  },
  "deployRefTemplate": "deploy-{id}-v{version}",
  "providers": {
    "cloudflare": {
      "name": "Cloudflare",
      "icon": "/assets/providers/cloudflare.svg",
      "buttonImage": "https://deploy.workers.cloudflare.com/button",
      "documentation": "https://developers.cloudflare.com/workers/platform/deploy-buttons/"
    },
    "vercel": {
      "name": "Vercel",
      "icon": "/assets/providers/vercel.svg",
      "buttonImage": "https://vercel.com/button",
      "documentation": "https://vercel.com/docs/deploy-button"
    },
    "render": {
      "name": "Render",
      "icon": "/assets/providers/render.svg",
      "buttonImage": "https://render.com/images/deploy-to-render-button.svg",
      "documentation": "https://render.com/docs/deploy-to-render"
    },
    "railway": {
      "name": "Railway",
      "icon": "/assets/providers/railway.svg",
      "buttonImage": "https://railway.com/button.svg",
      "documentation": "https://docs.railway.com/templates/publish-and-share"
    },
    "cloud-run": {
      "name": "Cloud Run",
      "icon": "/assets/providers/cloud-run.svg",
      "buttonImage": "https://deploy.cloud.run/button.svg",
      "documentation": "https://cloud.google.com/run/docs/deploying-source-code"
    },
    "app-runner": {
      "name": "AWS App Runner",
      "icon": "/assets/providers/app-runner.svg",
      "documentation": "https://docs.aws.amazon.com/apprunner/latest/dg/what-is-apprunner.html"
    },
    "docker": {
      "name": "Docker",
      "icon": "/assets/providers/docker.svg",
      "documentation": "https://docs.docker.com/compose/gettingstarted/"
    }
  },
  "environment": {
    "INTTEGRO_API_KEY": {
      "secret": true,
      "required": true,
      "documentation": "https://studio.inttegro.com/keys",
      "description": "A dedicated server-side Inttegro API key. Never expose it to browser or mobile code."
    },
    "INTTEGRO_DEMO_PRODUCT_ID": {
      "secret": false,
      "required": true,
      "documentation": "https://studio.inttegro.com/products",
      "description": "The active Inttegro Product selected by this demo. The trusted server looks it up at checkout."
    },
    "INTTEGRO_DEMO_PRICE_ID": {
      "secret": false,
      "required": true,
      "documentation": "https://studio.inttegro.com/products",
      "description": "An active Inttegro Price belonging to the configured demo Product."
    },
    "INTTEGRO_DEMO_PUBLIC_URL": {
      "secret": false,
      "required": true,
      "description": "The deployed origin used for checkout completion and cancellation URLs, without a trailing slash."
    },
    "DJANGO_CSRF_TRUSTED_ORIGINS": {
      "secret": false,
      "required": true,
      "default": false,
      "description": "The Django deployment's exact public HTTPS origin, used to validate browser form submissions behind a trusted proxy."
    },
    "INTTEGRO_DEMO_CUSTOMER_ID": {
      "secret": false,
      "required": true,
      "default": false,
      "description": "A test customer ID used only by the companion mobile-order route."
    }
  },
  "demos": [
    {
      "id": "nextjs",
      "live": { "status": "verified", "provider": "cloudflare", "url": "https://nextjs-demo.inttegro.dev" },
      "additionalEnvironment": ["INTTEGRO_DEMO_CUSTOMER_ID"],
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "prepared", "config": "nextjs/compose.yaml" },
        { "id": "vercel", "recommendation": "recommended", "status": "prepared", "config": "nextjs/vercel.json" },
        { "id": "cloudflare", "recommendation": "alternative", "status": "verified", "config": "nextjs/wrangler.jsonc" },
        { "id": "cloud-run", "recommendation": "alternative", "status": "blocked", "reason": "This release does not include a tested Cloud Run app.json contract for Next.js." },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers, and this release has no public ECR image." }
      ]
    },
    {
      "id": "nuxt",
      "live": { "status": "verified", "provider": "cloudflare", "url": "https://nuxt-demo.inttegro.dev" },
      "environmentAliases": {
        "INTTEGRO_API_KEY": "NUXT_INTTEGRO_API_KEY",
        "INTTEGRO_DEMO_PRODUCT_ID": "NUXT_DEMO_PRODUCT_ID",
        "INTTEGRO_DEMO_PRICE_ID": "NUXT_DEMO_PRICE_ID",
        "INTTEGRO_DEMO_PUBLIC_URL": "NUXT_DEMO_PUBLIC_URL"
      },
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "prepared", "config": "nuxt/compose.yaml" },
        { "id": "cloudflare", "recommendation": "recommended", "status": "verified", "config": "nuxt/wrangler.jsonc" },
        { "id": "vercel", "recommendation": "alternative", "status": "prepared", "config": "nuxt/vercel.json" },
        { "id": "cloud-run", "recommendation": "alternative", "status": "blocked", "reason": "This release does not include a tested Cloud Run app.json contract for Nuxt." },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers, and this release has no public ECR image." }
      ]
    },
    {
      "id": "express",
      "live": { "status": "verified", "provider": "cloudflare", "url": "https://express-demo.inttegro.dev" },
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "prepared", "config": "express/compose.yaml" },
        { "id": "railway", "recommendation": "recommended", "status": "prepared", "config": "express/railway.json", "templateId": "MJF7nD" },
        { "id": "render", "recommendation": "alternative", "status": "prepared", "config": "express/render.yaml" },
        { "id": "cloudflare", "recommendation": "alternative", "status": "verified", "config": "express/wrangler.jsonc" },
        { "id": "cloud-run", "recommendation": "alternative", "status": "prepared", "config": "express/app.json" },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers, and this release has no public ECR image." }
      ]
    },
    {
      "id": "django",
      "live": { "status": "verified", "provider": "railway", "url": "https://django-demo.inttegro.dev" },
      "additionalEnvironment": ["DJANGO_SECRET_KEY", "DJANGO_ALLOWED_HOSTS", "DJANGO_CSRF_TRUSTED_ORIGINS"],
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "prepared", "config": "django/compose.yaml" },
        { "id": "railway", "recommendation": "recommended", "status": "prepared", "config": "django/railway.json", "templateId": "0h-Ilj" },
        { "id": "render", "recommendation": "alternative", "status": "prepared", "config": "django/render.yaml" },
        { "id": "cloud-run", "recommendation": "alternative", "status": "prepared", "config": "django/app.json" },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers, and this release has no public ECR image." },
        { "id": "cloudflare", "recommendation": "experimental", "status": "blocked", "reason": "Python Workers supports asynchronous HTTP clients, while Inttegro Python SDK 6.0.0 currently uses synchronous urllib transport." }
      ]
    },
    {
      "id": "fastapi",
      "live": { "status": "verified", "provider": "railway", "url": "https://fastapi-demo.inttegro.dev" },
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "prepared", "config": "fastapi/compose.yaml" },
        { "id": "railway", "recommendation": "recommended", "status": "prepared", "config": "fastapi/railway.json", "templateId": "wk2B6a" },
        { "id": "render", "recommendation": "alternative", "status": "prepared", "config": "fastapi/render.yaml" },
        { "id": "cloud-run", "recommendation": "alternative", "status": "prepared", "config": "fastapi/app.json" },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers, and this release has no public ECR image." },
        { "id": "cloudflare", "recommendation": "experimental", "status": "blocked", "reason": "Python Workers supports asynchronous HTTP clients, while Inttegro Python SDK 6.0.0 currently uses synchronous urllib transport." }
      ]
    },
    {
      "id": "rails",
      "live": { "status": "verified", "provider": "railway", "url": "https://rails-demo.inttegro.dev" },
      "additionalEnvironment": ["SECRET_KEY_BASE"],
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "prepared", "config": "rails/compose.yaml" },
        { "id": "railway", "recommendation": "recommended", "status": "prepared", "config": "rails/railway.json", "templateId": "CssQzr" },
        { "id": "render", "recommendation": "alternative", "status": "prepared", "config": "rails/render.yaml" },
        { "id": "cloud-run", "recommendation": "alternative", "status": "prepared", "config": "rails/app.json" },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers, and this release has no public ECR image." }
      ]
    },
    {
      "id": "laravel",
      "live": { "status": "verified", "provider": "railway", "url": "https://laravel-demo.inttegro.dev" },
      "additionalEnvironment": ["APP_KEY"],
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "prepared", "config": "laravel/compose.yaml" },
        { "id": "railway", "recommendation": "recommended", "status": "prepared", "config": "laravel/railway.json", "templateId": "p5qiP5" },
        { "id": "render", "recommendation": "alternative", "status": "prepared", "config": "laravel/render.yaml" },
        { "id": "cloud-run", "recommendation": "alternative", "status": "prepared", "config": "laravel/app.json" },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers, and this release has no public ECR image." }
      ]
    },
    {
      "id": "go",
      "live": { "status": "verified", "provider": "railway", "url": "https://go-demo.inttegro.dev" },
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "prepared", "config": "go/compose.yaml" },
        { "id": "railway", "recommendation": "recommended", "status": "prepared", "config": "go/railway.json", "templateId": "ABT6ae" },
        { "id": "render", "recommendation": "alternative", "status": "prepared", "config": "go/render.yaml" },
        { "id": "cloud-run", "recommendation": "alternative", "status": "prepared", "config": "go/app.json" },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers, and this release has no public ECR image." }
      ]
    },
    {
      "id": "spring-boot",
      "providers": [
        { "id": "docker", "recommendation": "alternative", "status": "blocked", "reason": "The Java SDK 5.0.0 dependency must be publicly available before the Docker image can build." },
        { "id": "railway", "recommendation": "recommended", "status": "blocked", "config": "spring-boot/railway.json", "reason": "The Java SDK 5.0.0 dependency must be publicly available before a reader-owned remote build can succeed." },
        { "id": "render", "recommendation": "alternative", "status": "blocked", "config": "spring-boot/render.yaml", "reason": "The Java SDK 5.0.0 dependency must be publicly available before a reader-owned remote build can succeed." },
        { "id": "cloud-run", "recommendation": "alternative", "status": "blocked", "reason": "The Java SDK 5.0.0 dependency must be publicly available before a Cloud Run source build can succeed." },
        { "id": "app-runner", "recommendation": "experimental", "status": "blocked", "reason": "AWS App Runner is no longer available to new AWS customers; the Java SDK is also not public." }
      ]
    },
    { "id": "ios-swiftui", "mode": "native", "companionBackend": "nextjs", "providers": [] },
    { "id": "android-compose", "mode": "native", "companionBackend": "nextjs", "providers": [] },
    { "id": "flutter", "mode": "native", "companionBackend": "nextjs", "providers": [] },
    { "id": "react-native-expo", "mode": "native", "companionBackend": "nextjs", "providers": [] }
  ]
}
