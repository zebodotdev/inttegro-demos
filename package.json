{
  "name": "inttegro-demo-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "deploy:cloudflare": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@inttegro/inttegro-sdk": "7.0.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.129.0"
  },
  "engines": { "node": ">=24" },
  "cloudflare": {
    "bindings": {
      "INTTEGRO_API_KEY": {
        "description": "Create a test key in Inttegro Studio. This value remains server-side."
      },
      "INTTEGRO_DEMO_PUBLIC_URL": {
        "description": "Optional public origin for completion and cancellation URLs, without a trailing slash."
      }
    }
  }
}
